<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControleMateriais.Desktop.ViewModels"
             xmlns:conv="using:ControleMateriais.Desktop.Converters"
             xmlns:data="using:ControleMateriais.Data.Models"
             x:Class="ControleMateriais.Desktop.Views.PesagensView"
             x:DataType="vm:PesagensViewModel">

  <UserControl.Resources>
    <conv:BoolToBrushConverter x:Key="SyncStatusBrush"
                               TrueBrush="#4CAF50"
                               FalseBrush="#F44336"/>
    <conv:StatusPesagemBrushConverter x:Key="StatusCorBrush"/>
    <conv:StringEqualsConverter x:Key="StrEq"/>
    <conv:BoolToStringConverter x:Key="AtivoStatusTexto"
                                TrueText="Ativo"
                                FalseText="Inativo"/>
    <conv:BoolToStringConverter x:Key="AtivoStatusTooltip"
                                TrueText="Fornecedor ativo"
                                FalseText="Fornecedor inativo — clique para reativar"/>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="ToggleButton.filtro">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#555555"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="14,5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ToggleButton.filtro:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22FFFFFF"/>
    </Style>
    <Style Selector="ToggleButton.filtro:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#334CAF50"/>
      <Setter Property="BorderBrush" Value="#4CAF50"/>
    </Style>
    <Style Selector="ToggleButton.filtro:checked">
      <Setter Property="BorderBrush" Value="#4CAF50"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style Selector="ToggleButton.filtro:checked:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#4A4CAF50"/>
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource Brush.SurfaceAlt}"
          BorderBrush="{DynamicResource Brush.Border}"
          BorderThickness="1" CornerRadius="10" Padding="16">
    <Grid RowDefinitions="Auto,*">

      <!-- Cabeçalho global -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
        <Button Grid.Column="0"
                Content="← Início"
                HorizontalAlignment="Left"
                Command="{Binding VoltarCommand}"/>

        <TextBlock Grid.Column="1"
                   Text="Sistema de Recibos"
                   Classes="h1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Content="Nova Venda"
                  Command="{Binding IrParaVendaCommand}"
                  ToolTip.Tip="Registrar uma nova venda"/>
          <Button Content="Nova Compra"
                  Classes="primary"
                  Command="{Binding CriarNovoCommand}"
                  ToolTip.Tip="Criar recibo de compra do zero sem pesagem"/>
        </StackPanel>
      </Grid>

      <!-- TabControl -->
      <TabControl Grid.Row="1" Name="MainTabControl">

        <!-- ══════════════════════════════════════════════════
             ABA 1: COMPRAS
             ══════════════════════════════════════════════════ -->
        <TabItem Header="Compras">
          <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- Barra: filtros + botões -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,8,0,4">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox Text="{Binding FiltroReciboNome, Mode=TwoWay}"
                         Watermark="Buscar por nome..."
                         Width="180" FontSize="12"
                         VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding MesesDisponiveis}"
                          SelectedItem="{Binding FiltroReciboMes, Mode=TwoWay}"
                          Width="150" FontSize="12"
                          VerticalAlignment="Center"
                          ToolTip.Tip="Filtrar por mês"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="Atualizar"
                        IsEnabled="{Binding !SincronizandoRecibos}"
                        Command="{Binding SincronizarRecibosCommand}"
                        ToolTip.Tip="Sincronizar e recarregar a lista de recibos"/>
                <Button Content="Exportar Excel"
                        IsEnabled="{Binding !ExportandoExcel}"
                        Command="{Binding ExportarExcelCommand}"
                        ToolTip.Tip="Gerar planilha Excel com pesagens por dia de todos os recibos"/>
              </StackPanel>
            </Grid>

            <!-- Mensagem de status (sincronização / erros) -->
            <Border Grid.Row="1"
                    IsVisible="{Binding SyncRecibos.IsDone}"
                    Background="#111111"
                    BorderBrush="#4CAF50"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,2,0,4">
              <StackPanel Spacing="3">
                <Grid ColumnDefinitions="28,*">
                  <ProgressBar Grid.Column="0"
                               IsVisible="{Binding SyncRecibos.IsLoading}"
                               IsIndeterminate="True"
                               Width="16" Height="16"
                               Foreground="#4CAF50"
                               VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="0"
                             IsVisible="{Binding SyncRecibos.IsOk}"
                             Text="✓"
                             Foreground="#4CAF50"
                             FontSize="16"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="0"
                             IsVisible="{Binding SyncRecibos.IsWarn}"
                             Text="⚠"
                             Foreground="#FFC107"
                             FontSize="15"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="0"
                             IsVisible="{Binding SyncRecibos.IsError}"
                             Text="✗"
                             Foreground="#F44336"
                             FontSize="15"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1"
                             Text="{Binding SyncRecibos.Label}"
                             Foreground="White"
                             FontSize="13"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Margin="6,0,0,0"/>
                </Grid>
                <TextBlock Text="{Binding SyncRecibos.Mensagem}"
                           Foreground="#4CAF50"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="28,0,0,0"/>
                <ItemsControl ItemsSource="{Binding SyncRecibos.Detalhes}"
                              Margin="28,1,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"
                                 Foreground="#66BB6A"
                                 FontSize="10"
                                 TextWrapping="Wrap"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Corpo -->
            <Grid Grid.Row="3">

              <!-- Sem repositório Recibos clonado -->
              <StackPanel IsVisible="{Binding !RecibosDirPresente}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Spacing="12">
                <TextBlock Text="Repositório de Recibos não sincronizado."
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           FontSize="13"/>
              </StackPanel>

              <!-- Lista vazia de PDFs -->
              <TextBlock IsVisible="{Binding RecibosListaVazia}"
                         Text="Nenhum recibo encontrado no repositório local."
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextSecondary}"
                         FontSize="13"/>

              <!-- Lista de PDFs -->
              <Border IsVisible="{Binding RecibosDirPresente}"
                      Background="{DynamicResource Brush.SurfaceAlt}"
                      BorderBrush="{DynamicResource Brush.Border}"
                      BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid RowDefinitions="Auto,*">

                  <!-- Cabeçalho -->
                  <Grid Grid.Row="0" ColumnDefinitions="*,130,Auto" Margin="12,4,12,6">
                    <TextBlock Grid.Column="0" Text="Recibo" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Grid.Column="1" Text="Data" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Grid.Column="2" Text="" Width="76"/>
                  </Grid>

                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RecibosVisiveis}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReciboItem">
                          <Border BorderBrush="{DynamicResource Brush.Border}"
                                  BorderThickness="0,0,0,1"
                                  Padding="0,6">
                            <Border.Styles>
                              <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                              </Style>
                            </Border.Styles>
                            <Grid ColumnDefinitions="*,130,Auto" Margin="12,2">
                              <TextBlock Grid.Column="0"
                                         Text="{Binding NomeArquivo}"
                                         VerticalAlignment="Center"
                                         FontSize="13"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="White"/>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding DataCriacao}"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         Foreground="White"/>
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
                                <Button Content="Abrir"
                                        Width="76"
                                        FontSize="12"
                                        Click="AbrirPdf_Click"
                                        ToolTip.Tip="Abrir PDF do recibo"/>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                </Grid>
              </Border>

            </Grid>
          </Grid>
        </TabItem>

        <!-- ══════════════════════════════════════════════════
             ABA 2: VENDAS (movido de Controle de Estoque)
             ══════════════════════════════════════════════════ -->
        <TabItem Header="Vendas">
          <Grid RowDefinitions="Auto,Auto,*" DataContext="{Binding EstoqueVM}" x:DataType="vm:EstoqueViewModel">

            <!-- Filtros + botão Atualizar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,8,0,8">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox Text="{Binding FiltroNome}"
                         Watermark="Filtrar por cliente..."
                         Width="180" FontSize="12"
                         VerticalAlignment="Center"/>
                <TextBox Text="{Binding FiltroMes}"
                         Watermark="Mês/Ano (ex: 05/2026)"
                         Width="160" FontSize="12"
                         VerticalAlignment="Center"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Content="Atualizar"
                      Command="{Binding AtualizarCommand}"
                      IsEnabled="{Binding !Atualizando}"
                      FontSize="12"
                      VerticalAlignment="Center"/>
            </Grid>

            <!-- Status -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Status}"
                       IsVisible="{Binding StatusVisivel}"
                       HorizontalAlignment="Center"
                       FontSize="12" Foreground="#4CAF50"
                       Margin="0,0,0,4"/>

            <!-- Lista -->
            <Grid Grid.Row="2">
              <!-- Vazio -->
              <TextBlock IsVisible="{Binding RecibosVendaVazia}"
                         Text="Nenhum recibo de venda encontrado."
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextSecondary}"
                         FontSize="13"/>

              <Border IsVisible="{Binding !RecibosVendaVazia}"
                      Background="{DynamicResource Brush.SurfaceAlt}"
                      BorderBrush="{DynamicResource Brush.Border}"
                      BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid RowDefinitions="Auto,*">

                  <!-- Cabeçalho -->
                  <Grid Grid.Row="0" ColumnDefinitions="*,130,Auto" Margin="12,4,12,6">
                    <TextBlock Grid.Column="0" Text="Recibo" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Grid.Column="1" Text="Data" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Grid.Column="2" Text="" Width="76"/>
                  </Grid>

                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RecibosVenda}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReciboVendaItem">
                          <Border BorderBrush="{DynamicResource Brush.Border}"
                                  BorderThickness="0,0,0,1"
                                  Padding="0,6">
                            <Border.Styles>
                              <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                              </Style>
                            </Border.Styles>
                            <Grid ColumnDefinitions="*,130,Auto" Margin="12,2">
                              <TextBlock Grid.Column="0"
                                         Text="{Binding NomeCliente}"
                                         VerticalAlignment="Center"
                                         FontSize="13"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="White"/>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding DataCriacao}"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         Foreground="White"/>
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
                                <Button Content="Abrir"
                                        Width="76" FontSize="12"
                                        ToolTip.Tip="Abrir PDF do recibo"
                                        Command="{Binding $parent[ItemsControl].((vm:EstoqueViewModel)DataContext).AbrirReciboVendaCommand}"
                                        CommandParameter="{Binding}"/>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                </Grid>
              </Border>
            </Grid>

          </Grid>
        </TabItem>

        <!-- ══════════════════════════════════════════════════
             ABA 3: PESAGENS
             ══════════════════════════════════════════════════ -->
        <TabItem Header="Pesagens">
          <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- Barra: filtros + Sincronizar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,8,0,8">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ToggleButton Classes="filtro"
                              Content="Todos"
                              IsChecked="{Binding FiltroStatus, Converter={StaticResource StrEq}, ConverterParameter=todos, Mode=OneWay}"
                              Tag="todos"
                              Click="FiltroButton_Click"/>
                <ToggleButton Classes="filtro"
                              Content="{Binding LabelPendente}"
                              IsChecked="{Binding FiltroStatus, Converter={StaticResource StrEq}, ConverterParameter=pendente, Mode=OneWay}"
                              Tag="pendente"
                              Click="FiltroButton_Click"/>
                <ToggleButton Classes="filtro"
                              Content="{Binding LabelConcluido}"
                              IsChecked="{Binding FiltroStatus, Converter={StaticResource StrEq}, ConverterParameter=concluido, Mode=OneWay}"
                              Tag="concluido"
                              Click="FiltroButton_Click"/>
                <ToggleButton Classes="filtro"
                              Content="{Binding LabelFalhou}"
                              IsChecked="{Binding FiltroStatus, Converter={StaticResource StrEq}, ConverterParameter=falhou, Mode=OneWay}"
                              Tag="falhou"
                              Click="FiltroButton_Click"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Content="Atualizar"
                      IsEnabled="{Binding !Sincronizando}"
                      Command="{Binding SincronizarCommand}"
                      ToolTip.Tip="Sincronizar e recarregar a lista de pesagens"/>
            </Grid>

            <!-- Status sincronização pesagens -->
            <Border Grid.Row="1"
                    IsVisible="{Binding SyncPesagens.IsDone}"
                    Background="#111111"
                    BorderBrush="#2196F3"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,10"
                    Margin="0,0,0,6">
              <StackPanel Spacing="3">
                <Grid ColumnDefinitions="28,*">
                  <ProgressBar Grid.Column="0"
                               IsVisible="{Binding SyncPesagens.IsLoading}"
                               IsIndeterminate="True"
                               Width="16" Height="16"
                               Foreground="#2196F3"
                               VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="0"
                             IsVisible="{Binding SyncPesagens.IsOk}"
                             Text="✓"
                             Foreground="#4CAF50"
                             FontSize="16"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="0"
                             IsVisible="{Binding SyncPesagens.IsWarn}"
                             Text="⚠"
                             Foreground="#FFC107"
                             FontSize="15"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="0"
                             IsVisible="{Binding SyncPesagens.IsError}"
                             Text="✗"
                             Foreground="#F44336"
                             FontSize="15"
                             FontWeight="Bold"
                             VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1"
                             Text="{Binding SyncPesagens.Label}"
                             Foreground="White"
                             FontSize="13"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Margin="6,0,0,0"/>
                </Grid>
                <TextBlock Text="{Binding SyncPesagens.Mensagem}"
                           Foreground="#64B5F6"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="28,0,0,0"/>
                <ItemsControl ItemsSource="{Binding SyncPesagens.Detalhes}"
                              Margin="28,1,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}"
                                 Foreground="#90CAF9"
                                 FontSize="10"
                                 TextWrapping="Wrap"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <!-- Sem repositório local -->
            <StackPanel Grid.Row="2"
                        IsVisible="{Binding !RepoPresenteLocal}"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        Margin="0,24,0,0">
              <TextBlock Text="Repositório não sincronizado neste computador."
                         HorizontalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextSecondary}"
                         FontSize="13"/>
            </StackPanel>

            <!-- Lista pesagens -->
            <Border Grid.Row="3"
                    IsVisible="{Binding RepoPresenteLocal}"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="8" Padding="8">
              <Grid RowDefinitions="Auto,*">

                <Grid Grid.Row="0" ColumnDefinitions="*,160,110,Auto" Margin="12,4,12,6">
                  <TextBlock Grid.Column="0" Text="Cliente" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.TextPrimary}"/>
                  <TextBlock Grid.Column="1" Text="Data" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.TextPrimary}"/>
                  <TextBlock Grid.Column="2" Text="Status" FontWeight="Bold"
                             Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="" Width="80"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding PesagensFiltradas}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PesagemItem">
                        <Border BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="0,0,0,1"
                                Padding="0,6">
                          <Border.Styles>
                            <Style Selector="Border:pointerover">
                              <Setter Property="Background" Value="#22FFFFFF"/>
                            </Style>
                          </Border.Styles>
                          <Grid ColumnDefinitions="*,160,110,Auto" Margin="12,2">
                            <TextBlock Grid.Column="0" Text="{Binding Cliente}"
                                       VerticalAlignment="Center" FontSize="13" Foreground="White"
                                       Cursor="Hand"
                                       PointerPressed="PesagemNome_PointerPressed"/>
                            <TextBlock Grid.Column="1" Text="{Binding Horario}"
                                       VerticalAlignment="Center" FontSize="12" Foreground="White"/>
                            <TextBlock Grid.Column="2" Text="{Binding StatusPesagem}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       FontWeight="Bold" FontSize="12"
                                       Foreground="{Binding StatusPesagem, Converter={StaticResource StatusCorBrush}}"/>
                            <Button Grid.Column="3"
                                    Content="Excluir"
                                    Width="80"
                                    FontSize="12"
                                    Background="#C0392B"
                                    Foreground="White"
                                    Margin="6,0,0,0"
                                    Click="DeletarPesagem_Click"
                                    ToolTip.Tip="Excluir esta pesagem"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

              </Grid>
            </Border>

            <!-- Lista vazia -->
            <TextBlock Grid.Row="3"
                       IsVisible="{Binding ListaVazia}"
                       Text="Nenhuma pesagem encontrada para este filtro."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="13"/>

          </Grid>
        </TabItem>

        <!-- ══════════════════════════════════════════════════
             ABA 4: FORNECEDORES
             ══════════════════════════════════════════════════ -->
        <TabItem Header="Fornecedores">
          <Grid RowDefinitions="Auto,Auto,*">

            <!-- Barra: busca + atualizar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,8">
              <TextBox Grid.Column="0"
                       Text="{Binding FiltroFornecedorNome, Mode=TwoWay}"
                       Watermark="Buscar por nome..."
                       Width="220" FontSize="12"
                       VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1"
                         Text="Fornecedores cadastrados no banco de dados"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Right"
                         Margin="0,0,12,0"
                         FontSize="13"
                         Foreground="{DynamicResource Brush.TextSecondary}"/>
              <Button Grid.Column="2"
                      Content="Atualizar"
                      IsEnabled="{Binding !CarregandoFornecedores}"
                      Command="{Binding AtualizarFornecedoresCommand}"
                      ToolTip.Tip="Recarregar lista de fornecedores do banco de dados"/>
            </Grid>

            <!-- Status -->
            <TextBlock Grid.Row="1"
                       IsVisible="{Binding StatusFornecedoresVisivel}"
                       Text="{Binding StatusFornecedores}"
                       Foreground="#F44336"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>

            <!-- Corpo -->
            <Grid Grid.Row="2">

              <TextBlock IsVisible="{Binding FornecedoresListaVazia}"
                         Text="Nenhum fornecedor cadastrado."
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextSecondary}"
                         FontSize="13"/>

              <Border IsVisible="{Binding !FornecedoresListaVazia}"
                      Background="{DynamicResource Brush.SurfaceAlt}"
                      BorderBrush="{DynamicResource Brush.Border}"
                      BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid RowDefinitions="Auto,*">

                  <!-- Cabeçalho -->
                  <Grid Grid.Row="0" ColumnDefinitions="*,140,180,90,Auto" Margin="12,4,12,6">
                    <TextBlock Grid.Column="0" Text="Nome" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Grid.Column="1" Text="CNPJ" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Grid.Column="2" Text="Chave Pix" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Grid.Column="3" Text="Status" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Grid.Column="4" Text="" Width="176"/>
                  </Grid>

                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FornecedoresFiltrados}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="data:Usuario">
                          <Border BorderBrush="{DynamicResource Brush.Border}"
                                  BorderThickness="0,0,0,1"
                                  Padding="0,6">
                            <Border.Styles>
                              <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                              </Style>
                            </Border.Styles>
                            <Grid ColumnDefinitions="*,140,180,90,Auto" Margin="12,2">
                              <TextBlock Grid.Column="0"
                                         Text="{Binding Nome}"
                                         VerticalAlignment="Center"
                                         FontSize="13"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="White"/>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding Cnpj}"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         Foreground="White"/>
                              <TextBlock Grid.Column="2"
                                         Text="{Binding ChavePix}"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="White"/>
                              <TextBlock Grid.Column="3"
                                         Text="{Binding Ativo, Converter={StaticResource AtivoStatusTexto}}"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         FontWeight="Bold"
                                         Foreground="{Binding Ativo, Converter={StaticResource SyncStatusBrush}}"
                                         Cursor="Hand"
                                         PointerPressed="StatusFornecedor_PointerPressed"
                                         ToolTip.Tip="{Binding Ativo, Converter={StaticResource AtivoStatusTooltip}}"/>
                              <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
                                <Button Content="Editar"
                                        Width="82"
                                        FontSize="12"
                                        Click="EditarFornecedor_Click"
                                        ToolTip.Tip="Editar dados deste fornecedor"/>
                                <Button Content="Inativar"
                                        Width="80"
                                        FontSize="12"
                                        Background="#C0392B"
                                        Foreground="White"
                                        IsVisible="{Binding Ativo}"
                                        Click="ExcluirFornecedor_Click"
                                        ToolTip.Tip="Inativar este fornecedor (recibos não são afetados)"/>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                </Grid>
              </Border>

            </Grid>
          </Grid>
        </TabItem>

      </TabControl>

    </Grid>
  </Border>

</UserControl>

