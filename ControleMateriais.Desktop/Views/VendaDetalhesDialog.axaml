<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:data="using:ControleMateriais.Data.Models"
        x:Class="ControleMateriais.Desktop.Views.VendaDetalhesDialog"
        Title="Detalhes da Venda"
        Width="560" Height="560"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <Border Padding="20" Background="{DynamicResource Brush.Surface}">
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <TextBlock Grid.Row="0"
                 Text="Detalhes da Venda"
                 FontSize="16" FontWeight="Bold"
                 Foreground="White"
                 Margin="0,0,0,12"/>

      <!-- Cabeçalho do recibo -->
      <Border Grid.Row="1"
              Background="{DynamicResource Brush.SurfaceAlt}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="1" CornerRadius="8" Padding="14"
              Margin="0,0,0,12">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto,*">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Cliente:" FontWeight="Bold"
                     Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,8,4"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Name="ClienteText" FontSize="13"
                     Foreground="White" Margin="0,0,0,4" TextWrapping="Wrap"/>

          <TextBlock Grid.Row="0" Grid.Column="2" Text="Código:" FontWeight="Bold"
                     Foreground="{DynamicResource Brush.TextSecondary}" Margin="16,0,8,4"/>
          <TextBlock Grid.Row="0" Grid.Column="3" Name="CodigoText" FontSize="13"
                     Foreground="White" Margin="0,0,0,4"/>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Data:" FontWeight="Bold"
                     Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,8,4"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Name="DataText" FontSize="13"
                     Foreground="White" Margin="0,0,0,4"/>

          <TextBlock Grid.Row="1" Grid.Column="2" Text="Peso Total:" FontWeight="Bold"
                     Foreground="{DynamicResource Brush.TextSecondary}" Margin="16,0,8,4"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Name="PesoTotalText" FontSize="13"
                     Foreground="White" Margin="0,0,0,4"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Valor Total:" FontWeight="Bold"
                     Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,8,0"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Name="ValorTotalText" FontSize="13" FontWeight="Bold"
                     Foreground="#4CAF50"/>
        </Grid>
      </Border>

      <!-- Lista de itens -->
      <Border Grid.Row="2"
              Background="{DynamicResource Brush.SurfaceAlt}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="1" CornerRadius="8" Padding="8">
        <Grid RowDefinitions="Auto,*">

          <Grid Grid.Row="0" ColumnDefinitions="*,110" Margin="8,4,8,6">
            <TextBlock Grid.Column="0" Text="Item" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.TextPrimary}"/>
            <TextBlock Grid.Column="1" Text="Peso (kg)" FontWeight="Bold"
                       Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Right"/>
          </Grid>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="ItensList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="data:ReciboVendaItem">
                  <Border BorderBrush="{DynamicResource Brush.Border}"
                          BorderThickness="0,0,0,1"
                          Padding="0,6">
                    <Grid ColumnDefinitions="*,110" Margin="8,2">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding ItemNome}"
                                 VerticalAlignment="Center"
                                 FontSize="13"
                                 TextTrimming="CharacterEllipsis"
                                 Foreground="White"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding PesoKg, StringFormat={}{0:N3}}"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Right"
                                 FontSize="12"
                                 Foreground="White"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

        </Grid>
      </Border>

      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                  Spacing="10" Margin="0,16,0,0">
        <Button Content="Fechar" Click="Fechar_Click" Width="90"/>
      </StackPanel>

    </Grid>
  </Border>

</Window>
