<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControleMateriais.Desktop.ViewModels"
             xmlns:conv="using:ControleMateriais.Desktop.Converters"
             xmlns:data="using:ControleMateriais.Data.Models"
             x:Class="ControleMateriais.Desktop.Views.EstoqueView"
             x:DataType="vm:EstoqueViewModel">

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Cabeçalho -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="&#x1F4E6;" FontSize="22" VerticalAlignment="Center"/>
        <TextBlock Text="Controle de Estoque"
                   FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>

    <!-- Status -->
    <TextBlock Grid.Row="1"
               Text="{Binding Status}"
               IsVisible="{Binding StatusVisivel}"
               HorizontalAlignment="Center"
               FontSize="12" Foreground="#4CAF50"
               Margin="0,4,0,4"/>

    <!-- Abas: Compras | Estoque por Mês | Estoque -->
    <TabControl Grid.Row="2" x:Name="MainTabControl">

      <!-- ── ABA COMPRAS (Recibos de Compra do banco de dados) ───────── -->
      <TabItem Header="Compras">
        <Border Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="0,10,10,10" Padding="8">
          <Grid RowDefinitions="Auto,Auto,*">

            <!-- Filtro + botão Atualizar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,8">
              <TextBox Grid.Column="0"
                       Text="{Binding FiltroEntradas, Mode=TwoWay}"
                       Watermark="Buscar por cliente, código, data ou valor..."
                       Width="320" FontSize="12"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>
              <Button Grid.Column="1"
                      Content="Atualizar"
                      Command="{Binding AtualizarEntradasCommand}"
                      IsEnabled="{Binding !CarregandoEntradas}"
                      FontSize="12"
                      VerticalAlignment="Center"/>
            </Grid>

            <!-- Status -->
            <TextBlock Grid.Row="1"
                       Text="{Binding StatusEntradas}"
                       IsVisible="{Binding StatusEntradasVisivel}"
                       HorizontalAlignment="Center"
                       FontSize="12" Foreground="#F44336"
                       Margin="0,0,0,4"/>

            <!-- Lista -->
            <Grid Grid.Row="2">
              <TextBlock IsVisible="{Binding EntradasVazia}"
                         Text="Nenhuma entrada encontrada."
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextSecondary}"
                         FontSize="13"/>

              <Border IsVisible="{Binding !EntradasVazia}"
                      Background="{DynamicResource Brush.SurfaceAlt}"
                      BorderBrush="{DynamicResource Brush.Border}"
                      BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid RowDefinitions="Auto,*">

                  <!-- Cabeçalho -->
                  <Grid Grid.Row="0" ColumnDefinitions="*,90,110,120" Margin="12,4,12,6">
                    <TextBlock Grid.Column="0" Text="Cliente" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Grid.Column="1" Text="Código" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Grid.Column="2" Text="Data" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Grid.Column="3" Text="Valor Total" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Right"/>
                  </Grid>

                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding EntradasFiltradas}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="data:ReciboCompra">
                          <Border BorderBrush="{DynamicResource Brush.Border}"
                                  BorderThickness="0,0,0,1"
                                  Padding="0,6"
                                  Cursor="Hand"
                                  PointerPressed="EntradaRow_PointerPressed">
                            <Border.Styles>
                              <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                              </Style>
                            </Border.Styles>
                            <Grid ColumnDefinitions="*,90,110,120" Margin="12,2">
                              <TextBlock Grid.Column="0"
                                         Text="{Binding UsuarioNome}"
                                         VerticalAlignment="Center"
                                         FontSize="13"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="White"/>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding CodigoRecibo}"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         Foreground="White"/>
                              <TextBlock Grid.Column="2"
                                         Text="{Binding DataRecibo}"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         Foreground="White"/>
                              <TextBlock Grid.Column="3"
                                         Text="{Binding ValorTotal, StringFormat={}{0:C}}"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Right"
                                         FontSize="12"
                                         Foreground="#4CAF50"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                </Grid>
              </Border>
            </Grid>

          </Grid>
        </Border>
      </TabItem>

      <!-- ── ABA VENDAS (Recibos de Venda do banco de dados) ─────────── -->
      <TabItem Header="Vendas">
        <Border Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="0,10,10,10" Padding="8">
          <Grid RowDefinitions="Auto,Auto,*">

            <!-- Filtro + botões -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,8">
              <TextBox Grid.Column="0"
                       Text="{Binding FiltroVendasBanco, Mode=TwoWay}"
                       Watermark="Buscar por cliente, código, data ou valor..."
                       Width="320" FontSize="12"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>
              <Button Grid.Column="1"
                      Content="Importar PDFs"
                      Command="{Binding ImportarVendasBancoCommand}"
                      IsEnabled="{Binding !MigrandoVendasBanco}"
                      FontSize="12"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      ToolTip.Tip="Lê os PDFs existentes em Recibos_Venda e grava no banco de dados"/>
              <Button Grid.Column="2"
                      Content="Atualizar"
                      Command="{Binding AtualizarVendasBancoCommand}"
                      IsEnabled="{Binding !CarregandoVendasBanco}"
                      FontSize="12"
                      VerticalAlignment="Center"/>
            </Grid>

            <!-- Status -->
            <TextBlock Grid.Row="1"
                       Text="{Binding StatusVendasBanco}"
                       IsVisible="{Binding StatusVendasBancoVisivel}"
                       HorizontalAlignment="Center"
                       FontSize="12" Foreground="#4CAF50"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"/>

            <!-- Lista -->
            <Grid Grid.Row="2">
              <TextBlock IsVisible="{Binding VendasBancoVazia}"
                         Text="Nenhuma venda encontrada. Use &quot;Importar PDFs&quot; para ler os recibos existentes."
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextSecondary}"
                         FontSize="13"/>

              <Border IsVisible="{Binding !VendasBancoVazia}"
                      Background="{DynamicResource Brush.SurfaceAlt}"
                      BorderBrush="{DynamicResource Brush.Border}"
                      BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid RowDefinitions="Auto,*">

                  <!-- Cabeçalho -->
                  <Grid Grid.Row="0" ColumnDefinitions="*,90,110,120" Margin="12,4,12,6">
                    <TextBlock Grid.Column="0" Text="Cliente" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Grid.Column="1" Text="Código" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Grid.Column="2" Text="Data" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Grid.Column="3" Text="Valor Total" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}" HorizontalAlignment="Right"/>
                  </Grid>

                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding VendasBancoFiltradas}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="data:ReciboVenda">
                          <Border BorderBrush="{DynamicResource Brush.Border}"
                                  BorderThickness="0,0,0,1"
                                  Padding="0,6"
                                  Cursor="Hand"
                                  PointerPressed="VendaBancoRow_PointerPressed">
                            <Border.Styles>
                              <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                              </Style>
                            </Border.Styles>
                            <Grid ColumnDefinitions="*,90,110,120" Margin="12,2">
                              <TextBlock Grid.Column="0"
                                         Text="{Binding ClienteNome}"
                                         VerticalAlignment="Center"
                                         FontSize="13"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="White"/>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding CodigoRecibo}"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         Foreground="White"/>
                              <TextBlock Grid.Column="2"
                                         Text="{Binding DataVenda}"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         Foreground="White"/>
                              <TextBlock Grid.Column="3"
                                         Text="{Binding ValorTotal, StringFormat={}{0:C}}"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Right"
                                         FontSize="12"
                                         Foreground="#4CAF50"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                </Grid>
              </Border>
            </Grid>

          </Grid>
        </Border>
      </TabItem>

      <!-- ── ABA ESTOQUE POR MÊS (quantidade de cada item em Kg por mês) ── -->
      <TabItem Header="Estoque por Mês">
        <Border Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="0,10,10,10" Padding="8">
          <Grid RowDefinitions="Auto,Auto,*">

            <!-- Seletor de mês + botão Atualizar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,8">
              <ComboBox Grid.Column="0"
                        ItemsSource="{Binding MesesCompras}"
                        SelectedItem="{Binding MesSelecionadoCompras, Mode=TwoWay}"
                        Width="180" FontSize="12"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Selecionar mês"/>
              <Button Grid.Column="2"
                      Content="Atualizar"
                      Command="{Binding AtualizarTotaisMensaisCommand}"
                      IsEnabled="{Binding !CarregandoTotaisMensais}"
                      FontSize="12"
                      VerticalAlignment="Center"/>
            </Grid>

            <!-- Status -->
            <TextBlock Grid.Row="1"
                       Text="{Binding StatusTotaisMensais}"
                       IsVisible="{Binding StatusTotaisMensaisVisivel}"
                       HorizontalAlignment="Center"
                       FontSize="12" Foreground="#F44336"
                       Margin="0,0,0,4"/>

            <!-- Lista -->
            <Grid Grid.Row="2">
              <TextBlock IsVisible="{Binding ItensPorMesVazio}"
                         Text="Nenhum dado de compra encontrado para o mês selecionado."
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextSecondary}"
                         FontSize="13"/>

              <Border IsVisible="{Binding !ItensPorMesVazio}"
                      Background="{DynamicResource Brush.SurfaceAlt}"
                      BorderBrush="{DynamicResource Brush.Border}"
                      BorderThickness="1" CornerRadius="8" Padding="0">
                <Grid RowDefinitions="Auto,*">
                  <Border Grid.Row="0" Background="#1A3B82F6"
                          CornerRadius="8,8,0,0" Padding="20,12">
                    <Grid ColumnDefinitions="*,200">
                      <TextBlock Grid.Column="0" Text="Material"
                                 FontSize="12" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.TextPrimary}"/>
                      <TextBlock Grid.Column="1" Text="Total no Mês"
                                 FontSize="12" FontWeight="Bold"
                                 Foreground="{DynamicResource Brush.TextPrimary}"
                                 HorizontalAlignment="Right"/>
                    </Grid>
                  </Border>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ItensPorMes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ItemMensalWrapper">
                          <Border BorderBrush="{DynamicResource Brush.Border}"
                                  BorderThickness="0,0,0,1" Padding="20,9">
                            <Border.Styles>
                              <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="#0F3B82F6"/>
                              </Style>
                            </Border.Styles>
                            <Grid ColumnDefinitions="*,200">
                              <TextBlock Grid.Column="0" Text="{Binding Material}" FontSize="12"
                                         Foreground="{DynamicResource Brush.TextPrimary}"
                                         VerticalAlignment="Center"/>
                              <Border Grid.Column="1" CornerRadius="6" Padding="12,3"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Background="#0F555555" BorderBrush="#33555555" BorderThickness="1">
                                <TextBlock Text="{Binding TotalKgStr}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#4CAF50"
                                           HorizontalAlignment="Center"/>
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>

          </Grid>
        </Border>
      </TabItem>

      <!-- ── ABA ESTOQUE ─────────────────────────────────────────── -->
      <TabItem Header="Estoque">
        <Border Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="0,10,10,10" Padding="0">
          <!-- TODO: Em Progresso — lista de materiais desativada temporariamente -->
          <!--
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="#1A3B82F6"
                    CornerRadius="0,10,0,0" Padding="20,12">
              <Grid ColumnDefinitions="*,200">
                <TextBlock Grid.Column="0" Text="Material"
                           FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                <TextBlock Grid.Column="1" Text="Total em Estoque"
                           FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           HorizontalAlignment="Right"/>
              </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Itens}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EstoqueItem">
                    <Border BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,0,0,1" Padding="20,9">
                      <Border.Styles>
                        <Style Selector="Border:pointerover">
                          <Setter Property="Background" Value="#0F3B82F6"/>
                        </Style>
                      </Border.Styles>
                      <Grid ColumnDefinitions="*,200">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                          <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center">
                            <Border.Background>
                              <SolidColorBrush Color="{Binding TotalKg, Converter={x:Static conv:DecimalToColorConverter.Instance}}"/>
                            </Border.Background>
                          </Border>
                          <TextBlock Text="{Binding Material}" FontSize="12"
                                     Foreground="{DynamicResource Brush.TextPrimary}"
                                     VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="6" Padding="12,3"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="#0F555555" BorderBrush="#33555555" BorderThickness="1">
                          <TextBlock Text="{Binding TotalKgStr}"
                                     FontSize="12" FontWeight="SemiBold"
                                     HorizontalAlignment="Center">
                            <TextBlock.Foreground>
                              <SolidColorBrush Color="{Binding TotalKg, Converter={x:Static conv:DecimalToColorConverter.Instance}}"/>
                            </TextBlock.Foreground>
                          </TextBlock>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
          -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock Text="⚙ Em Progresso"
                       FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#FFC107"/>
            <TextBlock Text="Esta funcionalidade estará disponível em breve."
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}"/>
          </StackPanel>
        </Border>
      </TabItem>

    </TabControl>

  </Grid>

</UserControl>
