<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ControleMateriais.Desktop.ViewModels"
             xmlns:conv="using:ControleMateriais.Desktop.Converters"
             x:Class="ControleMateriais.Desktop.Views.EstoqueView"
             x:DataType="vm:EstoqueViewModel">

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- Cabeçalho -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="&#x1F4E6;" FontSize="22" VerticalAlignment="Center"/>
        <TextBlock Text="Controle de Estoque"
                   FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="&#x1F4B0; Venda"
                Command="{Binding IrParaVendaCommand}"
                ToolTip.Tip="Registrar uma venda e subtrair do estoque"/>
        <Button Content="&#x1F4C8; Migrar Vendas"
                Command="{Binding MigrarVendasCommand}"
                IsEnabled="{Binding !Migrando}"
                ToolTip.Tip="Gerar arquivos venda-DD-MM-YYYY.json a partir dos PDFs existentes"/>
      </StackPanel>
    </Grid>

    <!-- Status -->
    <TextBlock Grid.Row="1"
               Text="{Binding Status}"
               IsVisible="{Binding StatusVisivel}"
               HorizontalAlignment="Center"
               FontSize="12" Foreground="#4CAF50"
               Margin="0,4,0,4"/>

    <!-- Abas: Recibos de Venda | Estoque -->
    <TabControl Grid.Row="2" x:Name="MainTabControl">

      <!-- ── ABA RECIBOS DE VENDA ────────────────────────────────── -->
      <TabItem Header="Recibos de Venda">
        <Border Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="10,10,10,10" Padding="8">
          <Grid RowDefinitions="Auto,Auto,*">

            <!-- Filtros + botão Atualizar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4,0,8">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBox Text="{Binding FiltroNome}"
                         Watermark="Filtrar por cliente..."
                         Width="180" FontSize="12"
                         VerticalAlignment="Center"/>
                <TextBox Text="{Binding FiltroMes}"
                         Watermark="Mês/Ano (ex: 05/2026)"
                         Width="160" FontSize="12"
                         VerticalAlignment="Center"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Content="&#x27F3; Atualizar"
                      Command="{Binding AtualizarCommand}"
                      IsEnabled="{Binding !Atualizando}"
                      FontSize="12"
                      VerticalAlignment="Center"/>
            </Grid>

            <!-- Status -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Status}"
                       IsVisible="{Binding StatusVisivel}"
                       HorizontalAlignment="Center"
                       FontSize="12" Foreground="#4CAF50"
                       Margin="0,0,0,4"/>

            <!-- Lista -->
            <Grid Grid.Row="2">
              <!-- Vazio -->
              <TextBlock IsVisible="{Binding RecibosVendaVazia}"
                         Text="Nenhum recibo de venda encontrado."
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextSecondary}"
                         FontSize="13"/>

              <Border IsVisible="{Binding !RecibosVendaVazia}"
                      Background="{DynamicResource Brush.SurfaceAlt}"
                      BorderBrush="{DynamicResource Brush.Border}"
                      BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid RowDefinitions="Auto,*">

                  <!-- Cabeçalho -->
                  <Grid Grid.Row="0" ColumnDefinitions="*,130,Auto" Margin="12,4,12,6">
                    <TextBlock Grid.Column="0" Text="Recibo" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Grid.Column="1" Text="Data" FontWeight="Bold"
                               Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Grid.Column="2" Text="" Width="162"/>
                  </Grid>

                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding RecibosVenda}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReciboVendaItem">
                          <Border BorderBrush="{DynamicResource Brush.Border}"
                                  BorderThickness="0,0,0,1"
                                  Padding="0,6">
                            <Border.Styles>
                              <Style Selector="Border:pointerover">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                              </Style>
                            </Border.Styles>
                            <Grid ColumnDefinitions="*,130,Auto" Margin="12,2">
                              <TextBlock Grid.Column="0"
                                         Text="{Binding NomeCliente}"
                                         VerticalAlignment="Center"
                                         FontSize="13"
                                         TextTrimming="CharacterEllipsis"
                                         Foreground="White"/>
                              <TextBlock Grid.Column="1"
                                         Text="{Binding DataCriacao}"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         Foreground="White"/>
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="6,0,0,0">
                                <Button Content="📄 Abrir"
                                        Width="76" FontSize="12"
                                        ToolTip.Tip="Abrir PDF do recibo"
                                        Command="{Binding $parent[ItemsControl].((vm:EstoqueViewModel)DataContext).AbrirReciboVendaCommand}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="🗑 Excluir"
                                        Width="80" FontSize="12"
                                        Background="#C0392B" Foreground="White"
                                        ToolTip.Tip="Excluir este recibo"
                                        Command="{Binding $parent[ItemsControl].((vm:EstoqueViewModel)DataContext).ExcluirReciboVendaCommand}"
                                        CommandParameter="{Binding}"/>
                              </StackPanel>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>

                </Grid>
              </Border>
            </Grid>

          </Grid>
        </Border>
      </TabItem>

      <!-- ── ABA ESTOQUE ─────────────────────────────────────────── -->
      <TabItem Header="Estoque">
        <Border Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="0,10,10,10" Padding="0">
          <!-- TODO: Em Progresso — lista de materiais desativada temporariamente -->
          <!--
          <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" Background="#1A3B82F6"
                    CornerRadius="0,10,0,0" Padding="20,12">
              <Grid ColumnDefinitions="*,200">
                <TextBlock Grid.Column="0" Text="Material"
                           FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.TextPrimary}"/>
                <TextBlock Grid.Column="1" Text="Total em Estoque"
                           FontSize="12" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.TextPrimary}"
