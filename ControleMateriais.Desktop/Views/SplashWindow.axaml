<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ControleMateriais.Desktop.ViewModels"
        x:Class="ControleMateriais.Desktop.Views.SplashWindow"
        x:DataType="vm:SplashViewModel"
        Width="620" Height="520"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="#0C0C0C"
        FontFamily="avares://ControleMateriais.Desktop/Assets/Fonts#JetBrainsMono Nerd Font Mono"
        FontSize="14"
        Foreground="#CCCCCC"
        Icon="avares://ControleMateriais.Desktop/Assets/icon.ico">

  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#3FB950"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#3FB950"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="Padding" Value="16,8"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1F3D2A"/>
      <Setter Property="BorderBrush" Value="#3FB950"/>
      <Setter Property="Foreground" Value="#7EE787"/>
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="#30363D"/>
      <Setter Property="Foreground" Value="#484F58"/>
    </Style>
  </Window.Styles>

  <Border BorderBrush="#30363D" BorderThickness="1">
    <Grid RowDefinitions="Auto,*,Auto" Margin="40,32,40,32">

      <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="10">
        <Image Source="avares://ControleMateriais.Desktop/Assets/lfb-logo.png"
               Width="72" Height="72" Stretch="Uniform" HorizontalAlignment="Center"/>
        <TextBlock Text="LFB RECICLAGEM ELETRÔNICA"
                   FontWeight="Bold" FontSize="16" Foreground="#3FB950"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="$ sincronizando com o sistema remoto" Foreground="#8B949E"
                   FontSize="12" HorizontalAlignment="Center"/>
      </StackPanel>

      <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="18" Margin="0,24">

        <ItemsControl ItemsSource="{Binding Itens}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SyncItem">
              <Grid ColumnDefinitions="28,*,Auto" Margin="0,5">
                <TextBlock Grid.Column="0" IsVisible="{Binding IsLoading}"
                           Text="{Binding Spinner}" Foreground="#D29922" FontWeight="Bold"/>
                <TextBlock Grid.Column="0" IsVisible="{Binding IsOk}"
                           Text="&#xF05D;" Foreground="#3FB950" FontSize="16"/>
                <TextBlock Grid.Column="0" IsVisible="{Binding IsWarn}"
                           Text="&#xF071;" Foreground="#D29922" FontSize="16"/>
                <TextBlock Grid.Column="0" IsVisible="{Binding IsError}"
                           Text="&#xF05C;" Foreground="#F85149" FontSize="16"/>
                <TextBlock Grid.Column="1" Text="{Binding Texto}" TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="[ Saiba mais ]" Click="SaibaMais_Click"
                        IsVisible="{Binding TemErroTecnico}" Margin="10,0,0,0" Padding="10,3"
                        FontSize="12" Cursor="Hand"
                        BorderBrush="#F85149" Foreground="#F85149"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding BarraTexto}" Foreground="#3FB950" HorizontalAlignment="Left"/>

        <TextBlock IsVisible="{Binding SemInternet}"
                   Text="Sem conexão com a internet. Os dados locais serão usados e nada foi atualizado."
                   Foreground="#FF9800" TextWrapping="Wrap" FontSize="12"/>

        <StackPanel IsVisible="{Binding SemCredenciais}" Spacing="8">
          <TextBlock Text="&#xF071;  GitHub não configurado. Configure as credenciais para sincronizar."
                     Foreground="#F85149" TextWrapping="Wrap" FontSize="12"/>
          <Button Content="[ Configurar GitHub ]" Name="BtnConfigurar" HorizontalAlignment="Left"
                  Cursor="Hand"/>
        </StackPanel>
      </StackPanel>

      <Button Grid.Row="2" Content="[ Continuar ]" Name="BtnContinuar"
              IsEnabled="{Binding PodeContinuar}"
              HorizontalAlignment="Right" Cursor="Hand"/>
    </Grid>
  </Border>
</Window>
