              </ItemsControl>
            </ScrollViewer>
          </Grid>
          -->
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock Text="⚙ Em Progresso"
                       FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="#FFC107"/>
            <TextBlock Text="Esta funcionalidade estará disponível em breve."
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}"/>
          </StackPanel>
        </Border>
      </TabItem>

    </TabControl>

  </Grid>

</UserControl>
